{
  "_comment": "Architecture rules for RJ's Claude Framework. Generated by setup.sh, customizable per project.",
  "stack": "auto-detected",
  "rules": {
    "max_file_lines": 400,
    "max_function_lines": 50,
    "no_business_logic_in_routes": true,
    "no_duplicate_stores": true,
    "types_colocated": true,
    "consistent_naming": true
  },
  "naming": {
    "components": "PascalCase",
    "hooks": "use*.ts",
    "utils": "camelCase",
    "types": "PascalCase",
    "stores": "camelCase"
  },
  "boundaries": {
    "routes_can_import": ["features", "lib", "components"],
    "features_cannot_import": ["other_features"],
    "components_can_import": ["lib", "store"],
    "lib_cannot_import": ["components", "features", "app"]
  },
  "structure": {},
  "fdd": {
    "enabled": false,
    "features_dir": "src/features",
    "required": {
      "feature_folders": true,
      "separated_concerns": true,
      "quick_ref_per_feature": true,
      "import_boundaries": true
    },
    "recommended": {
      "service_extraction_threshold": 200,
      "handler_pattern": true,
      "utils_extraction": true
    },
    "feature_structure": {
      "components": "UI components for this feature",
      "hooks": "Custom hooks for this feature",
      "types.ts": "TypeScript types",
      "index.ts": "Barrel export (public API)",
      "QUICK_REF.md": "Feature documentation"
    },
    "recommended_structure": {
      "api": "API/service calls (when logic grows)",
      "utils": "Feature-specific utilities",
      "handlers": "Event handlers extracted from components"
    }
  }
}
